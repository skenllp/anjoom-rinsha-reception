# Public URL of the deployed site (no trailing slash). Needed for WhatsApp/Open Graph previews.
# On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL if you leave it empty.
VITE_SITE_URL=https://your-domain.vercel.app

# Wishes persistence (Supabase). Leave empty and the form shows a friendly "unavailable" state.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
